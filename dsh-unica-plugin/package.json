{
  "name": "dsh-plugin-unica",
  "version": "0.12.3",
  "private": true,
  "description": "Unica for DeepSeek Harness: 1C:Enterprise development skills plus the unica MCP server, exposed as DSH skills and MCP tools.",
  "license": "LGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "install-plugin": "node install.mjs",
    "package": "node package.mjs",
    "rebuild-skills": "node tools/build-skills.mjs",
    "check-refs": "node tools/check-refs.mjs .",
    "check-encoding": "node tools/check-encoding.mjs skills references"
  },
  "dsh": {
    "configTrees": [
      {
        "mount": "skills",
        "path": "skills",
        "scanRoster": true
      }
    ]
  },
  "unica": {
    "upstream": "https://github.com/IngvarConsulting/unica",
    "upstreamVersion": "0.12.3",
    "mcpServerName": "unica",
    "mcpTools": 74,
    "skills": 76,
    "referenceFiles": 48,
    "bootstrapTargets": [
      "darwin-arm64",
      "linux-x64",
      "win-x64"
    ]
  }
}
